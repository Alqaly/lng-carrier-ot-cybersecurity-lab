{
  "schema_version": 1,
  "principle": "container running is not equivalent to OT semantic readiness",
  "levels": [
    {
      "id": "process_alive",
      "meaning": "container/process exists and has not exited"
    },
    {
      "id": "reachable",
      "meaning": "expected HTTP/TCP endpoint is reachable from the intended observation point"
    },
    {
      "id": "commissioned",
      "meaning": "required PLC/project/protocol identities and bindings have been explicitly commissioned"
    },
    {
      "id": "semantic_ready",
