{
  "schema_version": 1,
  "required_fields": [
    "name",
    "source",
    "data_type",
    "unit_or_state",
    "timestamp_semantics",
    "quality_semantics",
    "freshness_semantics",
    "unavailable_behavior"
  ],
  "rules": {
    "no_fabricated_freshness": true,
    "no_substitute_process_values_on_publication_loss": true,
    "observer_time_is_not_source_time": true,
    "missing_or_ambiguous_opcua_identity_fails_closed": true
  },
  "authoritative_sources": {
    "process_and_io": ["plant/configs", "io_emulator/configs", "openplc/mapping_contract.json"],
    "opcua_identity": "live discovery evidence",
    "historian_binding": "verified generated binding plan",
    "alarm_semantics": "alarms/catalog.json"
  }
}
