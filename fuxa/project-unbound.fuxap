      {
        "id": "v_lab_1",
        "name": "Cargo Transfer",
        "profile": {
          "width": 1600,
          "height": 900,
          "bkcolor": "#1b2024ff"
        },
        "items": {},
        "variables": {},
        "svgcontent": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1600\" height=\"900\" viewBox=\"0 0 1600 900\">\n<rect width=\"1600\" height=\"900\" fill=\"#1b2024\"/>\n<text x=\"55\" y=\"62\" fill=\"#e7edf1\" font-family=\"Arial\" font-size=\"32\" font-weight=\"700\">CARGO TRANSFER \u2014 TASK OVERVIEW</text>\n<text x=\"55\" y=\"94\" fill=\"#9caab3\" font-family=\"Arial\" font-size=\"15\">Task: verify a safe, effective transfer from source to destination</text>\n<rect x=\"45\" y=\"125\" width=\"1510\" height=\"560\" rx=\"12\" fill=\"#22292e\" stroke=\"#59666f\"/>\n<rect x=\"45\" y=\"710\" width=\"1510\" height=\"130\" rx=\"12\" fill=\"#171b1e\" stroke=\"#59666f\"/>\n<text x=\"70\" y=\"745\" fill=\"#bbc5ca\" font-family=\"Arial\" font-size=\"15\">ACTIVE ALARMS \u2014 reserved attention region</text>\n<rect x=\"130\" y=\"270\" width=\"250\" height=\"190\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"255.0\" y=\"365.0\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">SOURCE TANK</text>\n<rect x=\"590\" y=\"315\" width=\"170\" height=\"85\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"675.0\" y=\"357.5\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">PUMP</text>\n<rect x=\"850\" y=\"315\" width=\"170\" height=\"85\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"935.0\" y=\"357.5\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">VALVE</text>\n<rect x=\"1180\" y=\"270\" width=\"250\" height=\"190\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"1305.0\" y=\"365.0\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">DESTINATION TANK</text>\n<rect x=\"80\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"95\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Source level</text>\n<text x=\"95\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 m</text>\n<rect x=\"325\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"340\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Destination</text>\n<text x=\"340\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 m</text>\n<rect x=\"570\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"585\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Flow</text>\n<text x=\"585\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 m\u00b3/h</text>\n<rect x=\"815\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"830\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Pressure</text>\n<text x=\"830\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 kPa</text>\n<rect x=\"1060\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"1075\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Valve</text>\n<text x=\"1075\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 %</text>\n<rect x=\"1305\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"1320\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Pump</text>\n<text x=\"1320\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 %</text>\n<text x=\"70\" y=\"815\" fill=\"#73818a\" font-family=\"Arial\" font-size=\"14\">Normal display is deliberately muted; abnormal conditions should gain visual priority.</text>\n</svg>"
      },
      {
        "id": "v_lab_2",
        "name": "Power Management",
        "profile": {
          "width": 1600,
          "height": 900,
          "bkcolor": "#1b2024ff"
        },
        "items": {},
        "variables": {},
        "svgcontent": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1600\" height=\"900\" viewBox=\"0 0 1600 900\">\n<rect width=\"1600\" height=\"900\" fill=\"#1b2024\"/>\n<text x=\"55\" y=\"62\" fill=\"#e7edf1\" font-family=\"Arial\" font-size=\"32\" font-weight=\"700\">POWER MANAGEMENT \u2014 SYSTEM OVERVIEW</text>\n<text x=\"55\" y=\"94\" fill=\"#9caab3\" font-family=\"Arial\" font-size=\"15\">Task: maintain electrical availability and sufficient reserve</text>\n<rect x=\"45\" y=\"125\" width=\"1510\" height=\"560\" rx=\"12\" fill=\"#22292e\" stroke=\"#59666f\"/>\n<rect x=\"45\" y=\"710\" width=\"1510\" height=\"130\" rx=\"12\" fill=\"#171b1e\" stroke=\"#59666f\"/>\n<text x=\"70\" y=\"745\" fill=\"#bbc5ca\" font-family=\"Arial\" font-size=\"15\">ACTIVE ALARMS \u2014 reserved attention region</text>\n<rect x=\"140\" y=\"260\" width=\"260\" height=\"150\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"270.0\" y=\"335.0\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">GENERATOR 1</text>\n<rect x=\"600\" y=\"260\" width=\"360\" height=\"150\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"780.0\" y=\"335.0\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">MAIN BUS</text>\n<rect x=\"1160\" y=\"260\" width=\"260\" height=\"150\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"1290.0\" y=\"335.0\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">GENERATOR 2</text>\n<rect x=\"80\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"95\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Frequency</text>\n<text x=\"95\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 Hz</text>\n<rect x=\"325\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"340\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Voltage</text>\n<text x=\"340\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 p.u.</text>\n<rect x=\"570\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"585\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Gen 1</text>\n<text x=\"585\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 kW</text>\n<rect x=\"815\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"830\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Gen 2</text>\n<text x=\"830\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 kW</text>\n<rect x=\"1060\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"1075\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Load</text>\n<text x=\"1075\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 kW</text>\n<rect x=\"1305\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"1320\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Reserve</text>\n<text x=\"1320\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 kW</text>\n<text x=\"70\" y=\"815\" fill=\"#73818a\" font-family=\"Arial\" font-size=\"14\">Normal display is deliberately muted; abnormal conditions should gain visual priority.</text>\n</svg>"
      },
      {
        "id": "v_lab_3",
        "name": "Propulsion & Machinery",
        "profile": {
          "width": 1600,
          "height": 900,
          "bkcolor": "#1b2024ff"
        },
        "items": {},
        "variables": {},
        "svgcontent": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1600\" height=\"900\" viewBox=\"0 0 1600 900\">\n<rect width=\"1600\" height=\"900\" fill=\"#1b2024\"/>\n<text x=\"55\" y=\"62\" fill=\"#e7edf1\" font-family=\"Arial\" font-size=\"32\" font-weight=\"700\">PROPULSION \u2014 MACHINERY OVERVIEW</text>\n<text x=\"55\" y=\"94\" fill=\"#9caab3\" font-family=\"Arial\" font-size=\"15\">Task: verify lubrication, engine state and commanded propulsion response</text>\n<rect x=\"45\" y=\"125\" width=\"1510\" height=\"560\" rx=\"12\" fill=\"#22292e\" stroke=\"#59666f\"/>\n<rect x=\"45\" y=\"710\" width=\"1510\" height=\"130\" rx=\"12\" fill=\"#171b1e\" stroke=\"#59666f\"/>\n<text x=\"70\" y=\"745\" fill=\"#bbc5ca\" font-family=\"Arial\" font-size=\"15\">ACTIVE ALARMS \u2014 reserved attention region</text>\n<rect x=\"120\" y=\"270\" width=\"250\" height=\"150\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"245.0\" y=\"345.0\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">PRE-LUBE / OIL</text>\n<rect x=\"510\" y=\"270\" width=\"260\" height=\"150\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"640.0\" y=\"345.0\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">ENGINE</text>\n<rect x=\"900\" y=\"270\" width=\"250\" height=\"150\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"1025.0\" y=\"345.0\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">SHAFT / PITCH</text>\n<rect x=\"1250\" y=\"270\" width=\"220\" height=\"150\" rx=\"10\" fill=\"#2a3237\" stroke=\"#7a8992\" stroke-width=\"2\"/>\n<text x=\"1360.0\" y=\"345.0\" fill=\"#e4eaed\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"18\">VESSEL RESPONSE</text>\n<rect x=\"80\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"95\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Engine</text>\n<text x=\"95\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 RPM</text>\n<rect x=\"325\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"340\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Lube oil</text>\n<text x=\"340\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 bar</text>\n<rect x=\"570\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"585\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Coolant</text>\n<text x=\"585\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 \u00b0C</text>\n<rect x=\"815\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"830\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Engine load</text>\n<text x=\"830\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 %</text>\n<rect x=\"1060\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"1075\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Torque</text>\n<text x=\"1075\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 N\u00b7m</text>\n<rect x=\"1305\" y=\"580\" width=\"210\" height=\"76\" rx=\"8\" fill=\"#171b1e\" stroke=\"#4f5a61\"/>\n<text x=\"1320\" y=\"605\" fill=\"#94a3ab\" font-family=\"Arial\" font-size=\"13\">Vessel</text>\n<text x=\"1320\" y=\"638\" fill=\"#eef2f4\" font-family=\"Arial\" font-size=\"24\">\u2014 kn</text>\n<text x=\"70\" y=\"815\" fill=\"#73818a\" font-family=\"Arial\" font-size=\"14\">Normal display is deliberately muted; abnormal conditions should gain visual priority.</text>\n</svg>"
      }
