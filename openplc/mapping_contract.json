      "pumpFeedback": "DI_PumpRunFB",
      "highHighDestination": "DI_HighHighDestination",
      "lowLowSource": "DI_LowLowSource"
    }
  },
  "pms": {
    "program": "openplc/pms/PowerManagement.st",
    "commands": {
      "gen1StartCmd": "DO_Gen1Start",
      "gen2StartCmd": "DO_Gen2Start",
      "gen1BreakerCmd": "DO_Gen1Breaker",
