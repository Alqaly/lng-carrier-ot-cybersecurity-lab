{
  "cargo": {
    "program": "openplc/cargo/CargoControl.st",
    "commands": {
      "pumpCmd": "DO_Pump",
      "valveCommand": "AO_ValvePermille"
    },
    "outputs": {
      "levelSource": "AI_LevelSource_mm",
      "levelDestination": "AI_LevelDestination_mm",
